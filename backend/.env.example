# Local development only. Copy to backend/.env — never commit the real file.

STAGE=local

# "memory" runs the API with no AWS at all. Switch to "dynamodb" once the
# tables exist and your AWS credentials are configured.
STORAGE=memory
AWS_REGION=us-east-1
BLOG_TABLE=lwt_blog_posts
INQUIRIES_TABLE=lwt_inquiries
APPLICATIONS_TABLE=lwt_applications
SUBSCRIBERS_TABLE=lwt_subscribers

# Exact origins only, comma-separated. Never "*".
CORS_ORIGINS=http://localhost:3000

# The staff dashboard's password. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production this comes from Secrets Manager, not from a file.
ADMIN_API_KEY=

# SES stays off until a sender identity is verified.
EMAIL_ENABLED=false
EMAIL_SENDER=
EMAIL_RECIPIENT=info@linkerworldtravel.com
