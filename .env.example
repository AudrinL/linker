# Frontend environment. Copy to .env.local for development; set the same keys
# in the Netlify UI for production.

# --------------------------------------------------------------- staff auth
# Supabase authenticates the people who use /admin. Both values are safe in the
# browser — the publishable key carries no privilege of its own.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional allowlist: only these addresses may enter, whatever Supabase says.
# Comma separated. Leave empty to allow any authenticated Supabase user — only
# safe if public sign-ups are disabled on the project (they should be).
ADMIN_EMAILS=

# ---------------------------------------------------------------- backend API
# Where the FastAPI backend lives. Locally that is uvicorn; in production it is
# the stack's ApiUrl output (see backend/README.md).
API_BASE_URL=http://127.0.0.1:8000

# Server-to-server bearer token for /admin routes on the backend. Must equal
# the backend's ADMIN_API_KEY. Never sent to a browser, and unrelated to how
# staff sign in.
ADMIN_API_KEY=

# ------------------------------------------------- local development fallback
# When the Supabase variables above are empty AND NODE_ENV is not production,
# /admin/login falls back to a single shared password so the dashboard runs
# with no cloud dependency. Both conditions must hold — this is refused in
# production. Defaults to ADMIN_API_KEY when unset.
ADMIN_PASSWORD=
SESSION_SECRET=
